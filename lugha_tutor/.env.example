# Django Core
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Hidden Django Admin URL (never use /admin/ in production)
ADMIN_URL_PATH=secure-faculty-admin-9f3a/

# Database (True = PostgreSQL; False = SQLite fallback)
USE_POSTGRES=True
DB_NAME=lugha_tutor_db
DB_USER=lugha_admin
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Paystack (M-Pesa Mobile Money + Visa/Mastercard in KES)
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=http://127.0.0.1:8000/payments/paystack/callback/

# CSRF & Site URL (for production HTTPS deployments)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
